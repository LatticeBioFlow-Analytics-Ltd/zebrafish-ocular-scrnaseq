# --- generated output -------------------------------------------------------
# Every run writes to results<suffix>/, named by the config that produced it:
#   results/                        config.yaml, uncorrected aggregates
#   results_cellbender/             config_cellbender.yaml, the current analysis
#   results_cellbender_nodoublets/  the same, with doublet removal disabled
# Roughly 1.2 GB each, and regenerable from the inputs plus the committed
# config, so none of them are tracked.
results*/
*.h5ad

# Run logs live beside the outputs they describe; the run manifest inside each
# results directory is the durable provenance record.
run_*.log

# --- build artefacts --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- pixi -------------------------------------------------------------------
# The environment directory is generated. pixi.lock MUST be committed: it is
# what makes `pixi install` reproduce the environment rather than re-solve it.
.pixi/

# figures/ is deliberately NOT ignored: it holds the small set of showcase
# figures copied out of results/figures/ and committed so the output can be
# seen without running anything.

# --- test fixtures ----------------------------------------------------------
tests/fixtures/synthetic/

# --- data -------------------------------------------------------------------
# data/ IS ignored, reversing an earlier decision to ship the matrices with the
# repository. Two reasons, both of which arrived after that decision was made:
#
#   - It is now 383 MB — the 22 per-library CellBender matrices (245 MB) as well
#     as the two per-timepoint aggregates (130 MB), where it was once just the
#     latter.
#   - DATA.md states that these data are public, were not generated by this lab,
#     and that anyone wanting them should obtain them from the archive rather
#     than from this repository. Committing 383 MB of third-party sequencing
#     output would contradict the position the repository takes about it.
#
# The inputs are fully specified without shipping them: the upstream workflow
# (cellranger-cellbender-workflow) rebuilds every matrix from public SRA
# accessions, config/libraries.tsv names each library, and each run manifest
# records the SHA-256 of every file that produced it.
data/

# --- macOS -------------------------------------------------------------------
.DS_Store
